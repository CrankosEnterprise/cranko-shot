<Window x:Class="ShotMind.UI.Views.AiResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrankoShot — Inteligência Visual &amp; IA"
        Width="660" Height="700"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowGradientBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Image Context Banner -->
            <RowDefinition Height="*" />    <!-- Chat History List -->
            <RowDefinition Height="Auto" /> <!-- Web Sources (if any) -->
            <RowDefinition Height="Auto" /> <!-- Progress Indicator -->
            <RowDefinition Height="Auto" /> <!-- Input & Send Section -->
            <RowDefinition Height="Auto" /> <!-- Footer Controls -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="#26262B" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock x:Name="StatusBadgeText" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11" FontWeight="Bold" Text="PRONTO" />
                    </Border>
                    <Button x:Name="BtnClearChat" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,0" Margin="0,0,6,0" Click="BtnClearChat_Click" ToolTip="Limpar conversa">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Limpar" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="ActionTitleText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Text="Perguntar à IA" />
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Conversa baseada na captura de tela atual" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Image Context Banner -->
        <Border Grid.Row="1" x:Name="ImageContextBanner" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="🖼️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtContextInfo" Foreground="#C7D2FE" FontSize="11.5" VerticalAlignment="Center" Text="Captura associada como contexto visual." TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Chat History List -->
        <Border Grid.Row="2" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Message Bubble Container -->
                            <Grid Margin="0,4,0,8">
                                <!-- User Bubble (Right Aligned) -->
                                <Border HorizontalAlignment="Right"
                                        MaxWidth="480"
                                        Background="{DynamicResource AccentUserBubbleBrush}"
                                        CornerRadius="12,12,2,12"
                                        Padding="12,8"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="White"
                                                   FontSize="13.5"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19"/>
                                        <TextBlock Text="{Binding TimeFormatted}"
                                                   Foreground="#DDD6FE"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- AI Model Bubble (Left Aligned) -->
                                <Border HorizontalAlignment="Left"
                                        MaxWidth="500"
                                        Background="#27272A"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="12,12,12,2"
                                        Padding="12,10"
                                        Visibility="{Binding IsModel, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProviderLabel}" Foreground="{DynamicResource AccentLightBrush}" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource ToolbarIconButton}"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    ToolTip="Copiar resposta"
                                                    Tag="{Binding Text}"
                                                    Click="BtnCopyMessage_Click">
                                                <TextBlock Text="📋" FontSize="11" Foreground="#A1A1AA"/>
                                            </Button>
                                        </DockPanel>
                                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 FontSize="13.5"
                                                 FontFamily="Segoe UI"
                                                 TextWrapping="Wrap"
                                                 IsReadOnly="True"
                                                 VerticalContentAlignment="Top"
                                                 Padding="0"/>
                                        <TextBlock Text="{Binding TimeFormatted}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Error Bubble (Left Aligned) -->
                                <Border HorizontalAlignment="Left"
                                        MaxWidth="500"
                                        Background="#3F1D1D"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                            <TextBlock Text="⚠ Falha na comunicação" Foreground="#FCA5A5" FontSize="11.5" FontWeight="Bold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#FEE2E2"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Web Sources Section (Grounding) -->
        <Border Grid.Row="3" x:Name="SourcesSection" Background="#1A1A1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Fontes e Links Encontrados na Web:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl x:Name="SourcesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2">
                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentPrimaryBrush}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Progress Indicator -->
        <Border Grid.Row="4" x:Name="ProcessingIndicator" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <ProgressBar Height="3" IsIndeterminate="True" Foreground="{DynamicResource AccentPrimaryBrush}" Background="#27272A" BorderThickness="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtProcessingStatus" Text="O Gemini está analisando o contexto e gerando a resposta..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- Input & Send Section -->
        <Border Grid.Row="5" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="QuestionInput"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="13.5"
                         FontFamily="Segoe UI"
                         Padding="4"
                         MinHeight="38"
                         MaxHeight="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="QuestionInput_PreviewKeyDown" />

                <!-- Action button (Send or Cancel) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button x:Name="BtnCancelRequest" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="10,0" Margin="0,0,6,0" Click="BtnCancelRequest_Click" Visibility="Collapsed" ToolTip="Interromper requisição atual">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Parar" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSendMessage" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Click="BtnSendMessage_Click" ToolTip="Enviar pergunta (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➤" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Enviar" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Controls -->
        <DockPanel Grid.Row="6" LastChildFill="False" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Dica: Pressione Enter para enviar, Shift+Enter para quebra de linha." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click">
                <TextBlock Text="Fechar"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
