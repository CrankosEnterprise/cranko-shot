<Window x:Class="ShotMind.UI.Views.FullEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrankoShot — Editor de Imagens"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowGradientBrush}"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar / Menu -->
            <RowDefinition Height="*" />    <!-- Canvas Area -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Menu & Tools (Glassmorphic Header Bar) -->
        <Border Grid.Row="0" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- Left: File Operations -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnImport_Click" ToolTip="Abrir / Importar imagem do computador">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,4,0"/>
                            <TextBlock Text="Abrir"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnSave_Click" ToolTip="Salvar alterações (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,4,0"/>
                            <TextBlock Text="Salvar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Click="BtnSaveAs_Click" ToolTip="Salvar como nova versão">
                        <TextBlock Text="Salvar Como..."/>
                    </Button>

                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,12,2" />

                    <!-- Tools with Dropdown / Flyout Option Popups -->
                    <!-- Pen / Pencil -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolPen" Style="{StaticResource ToolbarIconButton}" ToolTip="Caneta / Lápis (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Pen" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="✎" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorPenMenu" PlacementTarget="{Binding ElementName=BtnToolPen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="170">
                                    <TextBlock Text="Caneta &amp; Lápis" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnEditorPenNormal" Grid.Column="0" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Padding="4,2" Click="BtnPenMode_Click" Tag="Normal" ToolTip="Traço sólido">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✎" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Normal" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnEditorPenPencil" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Margin="2,0,0,0" Padding="4,2" Click="BtnPenMode_Click" Tag="Pencil" ToolTip="Traço estilo lápis">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✏" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Lápis" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,6"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorPenThicknessValue" Text="3 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnPenThicknessPreset_Click" Tag="2" ToolTip="Fina (2px)">
                                            <Rectangle Width="16" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnPenThicknessPreset_Click" Tag="4" ToolTip="Média (4px)">
                                            <Rectangle Width="16" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnPenThicknessPreset_Click" Tag="8" ToolTip="Grossa (8px)">
                                            <Rectangle Width="16" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnPenThicknessPreset_Click" Tag="14" ToolTip="Muito Grossa (14px)">
                                            <Rectangle Width="16" Height="12" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" RadiusX="1" RadiusY="1"/>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorPenThickness" Minimum="1" Maximum="32" Value="3" SmallChange="1" LargeChange="2" Margin="2,2" ValueChanged="SliderEditorPenThickness_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Highlighter -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolHighlighter" Style="{StaticResource ToolbarIconButton}" ToolTip="Marca-texto (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Highlighter" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="🖍" FontSize="12"/>
                        </Button>
                        <Popup x:Name="PopupEditorHighlighterMenu" PlacementTarget="{Binding ElementName=BtnToolHighlighter}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="176">
                                    <TextBlock Text="Marca-texto" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorHlThicknessValue" Text="20 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlThicknessPreset_Click" Tag="12" ToolTip="Fina (12px)">
                                            <TextBlock Text="12px" FontSize="10.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlThicknessPreset_Click" Tag="20" ToolTip="Média (20px)">
                                            <TextBlock Text="20px" FontSize="10.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlThicknessPreset_Click" Tag="32" ToolTip="Grossa (32px)">
                                            <TextBlock Text="32px" FontSize="10.5"/>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorHlThickness" Minimum="8" Maximum="60" Value="20" SmallChange="2" LargeChange="5" Margin="2,2" ValueChanged="SliderEditorHlThickness_ValueChanged"/>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,4"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Opacidade:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorHlOpacityValue" Text="35%" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlOpacityPreset_Click" Tag="77" ToolTip="Suave (30%)">
                                            <TextBlock Text="30%" FontSize="10.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlOpacityPreset_Click" Tag="128" ToolTip="Média (50%)">
                                            <TextBlock Text="50%" FontSize="10.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="6,2" Click="BtnHlOpacityPreset_Click" Tag="204" ToolTip="Forte (80%)">
                                            <TextBlock Text="80%" FontSize="10.5"/>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorHlOpacity" Minimum="25" Maximum="255" Value="90" SmallChange="10" LargeChange="25" Margin="2,2" ValueChanged="SliderEditorHlOpacity_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Line -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolLine" Style="{StaticResource ToolbarIconButton}" ToolTip="Linha Reta (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Line" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="╱" FontSize="14" FontWeight="Bold"/>
                        </Button>
                        <Popup x:Name="PopupEditorLineMenu" PlacementTarget="{Binding ElementName=BtnToolLine}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="170">
                                    <TextBlock Text="Linha Reta" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorLineThicknessValue" Text="3 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnLineThicknessPreset_Click" Tag="2" ToolTip="Fina (2px)">
                                            <Rectangle Width="16" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnLineThicknessPreset_Click" Tag="4" ToolTip="Média (4px)">
                                            <Rectangle Width="16" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnLineThicknessPreset_Click" Tag="8" ToolTip="Grossa (8px)">
                                            <Rectangle Width="16" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnLineThicknessPreset_Click" Tag="14" ToolTip="Muito Grossa (14px)">
                                            <Rectangle Width="16" Height="12" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" RadiusX="1" RadiusY="1"/>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorLineThickness" Minimum="1" Maximum="32" Value="3" SmallChange="1" LargeChange="2" Margin="2,2" ValueChanged="SliderEditorLineThickness_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Arrow -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolArrow" Style="{StaticResource ToolbarIconButton}" ToolTip="Seta (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Arrow" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="➔" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorArrowMenu" PlacementTarget="{Binding ElementName=BtnToolArrow}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="170">
                                    <TextBlock Text="Seta" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorArrowThicknessValue" Text="3 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnArrowThicknessPreset_Click" Tag="2" ToolTip="Fina (2px)">
                                            <Rectangle Width="16" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnArrowThicknessPreset_Click" Tag="4" ToolTip="Média (4px)">
                                            <Rectangle Width="16" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnArrowThicknessPreset_Click" Tag="8" ToolTip="Grossa (8px)">
                                            <Rectangle Width="16" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnArrowThicknessPreset_Click" Tag="14" ToolTip="Muito Grossa (14px)">
                                            <Rectangle Width="16" Height="12" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" RadiusX="1" RadiusY="1"/>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorArrowThickness" Minimum="1" Maximum="32" Value="3" SmallChange="1" LargeChange="2" Margin="2,2" ValueChanged="SliderEditorArrowThickness_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Rectangle -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolRect" Style="{StaticResource ToolbarIconButton}" ToolTip="Retângulo (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Rectangle" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="▭" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorRectMenu" PlacementTarget="{Binding ElementName=BtnToolRect}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="188">
                                    <TextBlock Text="Retângulo" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Preenchimento:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,6">
                                        <Button x:Name="BtnRectFillNone" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnRectFill_Click" Tag="None" ToolTip="Somente Contorno">
                                            <TextBlock Text="Contorno" FontSize="10.5"/>
                                        </Button>
                                        <Button x:Name="BtnRectFillTranslucent" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnRectFill_Click" Tag="Translucent" ToolTip="Preenchimento Translúcido (30%)">
                                            <TextBlock Text="Translúcido" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="BtnRectFillSolid" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnRectFill_Click" Tag="Solid" ToolTip="Preenchimento Sólido (100%)">
                                            <TextBlock Text="Sólido" FontSize="10.5"/>
                                        </Button>
                                    </UniformGrid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,4"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura da borda:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorRectThicknessValue" Text="3 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnRectThicknessPreset_Click" Tag="2" ToolTip="Fina (2px)">
                                            <Rectangle Width="16" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnRectThicknessPreset_Click" Tag="4" ToolTip="Média (4px)">
                                            <Rectangle Width="16" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnRectThicknessPreset_Click" Tag="8" ToolTip="Grossa (8px)">
                                            <Rectangle Width="16" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorRectThickness" Minimum="1" Maximum="20" Value="3" SmallChange="1" LargeChange="2" Margin="2,2" ValueChanged="SliderEditorRectThickness_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Ellipse -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolEllipse" Style="{StaticResource ToolbarIconButton}" ToolTip="Círculo / Elipse (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Ellipse" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="◯" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorEllipseMenu" PlacementTarget="{Binding ElementName=BtnToolEllipse}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="188">
                                    <TextBlock Text="Círculo / Elipse" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Preenchimento:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,6">
                                        <Button x:Name="BtnEllipseFillNone" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEllipseFill_Click" Tag="None" ToolTip="Somente Contorno">
                                            <TextBlock Text="Contorno" FontSize="10.5"/>
                                        </Button>
                                        <Button x:Name="BtnEllipseFillTranslucent" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEllipseFill_Click" Tag="Translucent" ToolTip="Preenchimento Translúcido (30%)">
                                            <TextBlock Text="Translúcido" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="BtnEllipseFillSolid" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEllipseFill_Click" Tag="Solid" ToolTip="Preenchimento Sólido (100%)">
                                            <TextBlock Text="Sólido" FontSize="10.5"/>
                                        </Button>
                                    </UniformGrid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,4"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Espessura da borda:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorEllipseThicknessValue" Text="3 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnEllipseThicknessPreset_Click" Tag="2" ToolTip="Fina (2px)">
                                            <Rectangle Width="16" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnEllipseThicknessPreset_Click" Tag="4" ToolTip="Média (4px)">
                                            <Rectangle Width="16" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="32" Height="24" Margin="1,0" Click="BtnEllipseThicknessPreset_Click" Tag="8" ToolTip="Grossa (8px)">
                                            <Rectangle Width="16" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SliderEditorEllipseThickness" Minimum="1" Maximum="20" Value="3" SmallChange="1" LargeChange="2" Margin="2,2" ValueChanged="SliderEditorEllipseThickness_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Text -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolText" Style="{StaticResource ToolbarIconButton}" ToolTip="Texto (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Text" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="T" FontSize="14" FontWeight="Bold"/>
                        </Button>
                        <Popup x:Name="PopupEditorTextMenu" PlacementTarget="{Binding ElementName=BtnToolText}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="180">
                                    <TextBlock Text="Texto" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Tamanho da fonte:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorFontSizeValue" Text="18 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,2,0,4">
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnTextSizePreset_Click" Tag="14" ToolTip="Pequeno (14px)">
                                            <TextBlock Text="14" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnTextSizePreset_Click" Tag="18" ToolTip="Médio (18px)">
                                            <TextBlock Text="18" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnTextSizePreset_Click" Tag="26" ToolTip="Grande (26px)">
                                            <TextBlock Text="26" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnTextSizePreset_Click" Tag="36" ToolTip="Extra (36px)">
                                            <TextBlock Text="36" FontSize="10"/>
                                        </Button>
                                    </UniformGrid>
                                    <Slider x:Name="SliderEditorFontSize" Minimum="10" Maximum="64" Value="18" SmallChange="2" LargeChange="4" Margin="2,2" ValueChanged="SliderEditorFontSize_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Blur / Obfuscation -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolBlur" Style="{StaticResource ToolbarIconButton}" ToolTip="Desfoque / Ocultação (Passe o mouse para opções)" Click="BtnTool_Click" Tag="Blur" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="▦" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorBlurMenu" PlacementTarget="{Binding ElementName=BtnToolBlur}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="184">
                                    <TextBlock Text="Tipo de Ocultação" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnEditorBlurMode" Grid.Column="0" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Padding="4,2" Click="BtnEditorBlurMode_Click" ToolTip="Desfoque suave">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💧" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Blur" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnEditorPixelateMode" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Margin="2,0,0,0" Padding="4,2" Click="BtnEditorPixelateMode_Click" ToolTip="Mosaico em blocos">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▦" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Pixelado" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Intensidade:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorBlurIntensityValue" Text="12 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderEditorBlurIntensity" Minimum="2" Maximum="36" Value="12" SmallChange="1" LargeChange="4" TickFrequency="2" IsSnapToTickEnabled="True" Margin="2,2" ValueChanged="SliderEditorBlurIntensity_ValueChanged"/>
                                    <UniformGrid Columns="3" Margin="0,2,0,0">
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorBlurPreset_Click" Tag="4" ToolTip="Suave (4px)">
                                            <TextBlock Text="Suave" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorBlurPreset_Click" Tag="12" ToolTip="Médio (12px)">
                                            <TextBlock Text="Médio" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorBlurPreset_Click" Tag="24" ToolTip="Forte (24px)">
                                            <TextBlock Text="Forte" FontSize="10"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Step Marker -->
                    <Grid Margin="1,0">
                        <Button x:Name="BtnToolMarker" Style="{StaticResource ToolbarIconButton}" ToolTip="Marcador Numerado (Passe o mouse para opções)" Click="BtnTool_Click" Tag="StepMarker" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="①" FontSize="14"/>
                        </Button>
                        <Popup x:Name="PopupEditorMarkerMenu" PlacementTarget="{Binding ElementName=BtnToolMarker}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="192">
                                    <TextBlock Text="Estilo dos Marcadores" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button x:Name="BtnEditorMarkerNumbers" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="4,3" Click="BtnEditorMarkerStyle_Click" Tag="Numbers" ToolTip="Números: 1, 2, 3...">
                                            <TextBlock Text="1️⃣ 1, 2, 3" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnEditorMarkerUpper" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="4,3" Click="BtnEditorMarkerStyle_Click" Tag="Uppercase" ToolTip="Letras Maiúsculas: A, B, C...">
                                            <TextBlock Text="🔤 A, B, C" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnEditorMarkerLower" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="4,3" Click="BtnEditorMarkerStyle_Click" Tag="Lowercase" ToolTip="Letras Minúsculas: a, b, c...">
                                            <TextBlock Text="🔡 a, b, c" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnEditorMarkerDots" Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="4,3" Click="BtnEditorMarkerStyle_Click" Tag="Dots" ToolTip="Pontos sólidos sem texto">
                                            <TextBlock Text="⚫ Pontos" FontSize="11"/>
                                        </Button>
                                    </UniformGrid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,4"/>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Tamanho:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditorMarkerSizeValue" Text="26 px" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="3" Margin="0,2,0,6">
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorMarkerSizePreset_Click" Tag="20" ToolTip="Pequeno (20px)">
                                            <TextBlock Text="Pequeno" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorMarkerSizePreset_Click" Tag="26" ToolTip="Médio (26px)">
                                            <TextBlock Text="Médio" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ChipButtonStyle}" Margin="1" Padding="2,2" Click="BtnEditorMarkerSizePreset_Click" Tag="34" ToolTip="Grande (34px)">
                                            <TextBlock Text="Grande" FontSize="10"/>
                                        </Button>
                                    </UniformGrid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="6,2" FontSize="11" Click="BtnEditorRestartMarkerSequence_Click" ToolTip="Reiniciar a contagem da sequência a partir do 1 ou A">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🔄" Margin="0,0,4,0"/>
                                            <TextBlock Text="Reiniciar Sequência"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                    <!-- Quick Colors -->
                    <Button x:Name="BtnColorPurple" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#8B5CF6">
                        <Ellipse Width="14" Height="14" Fill="#8B5CF6"/>
                    </Button>
                    <Button x:Name="BtnColorRed" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#EF4444">
                        <Ellipse Width="14" Height="14" Fill="#EF4444"/>
                    </Button>
                    <Button x:Name="BtnColorGreen" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#10B981">
                        <Ellipse Width="14" Height="14" Fill="#10B981"/>
                    </Button>
                    <Button x:Name="BtnColorBlue" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#3B82F6">
                        <Ellipse Width="14" Height="14" Fill="#3B82F6"/>
                    </Button>
                    <Button x:Name="BtnColorYellow" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#F59E0B">
                        <Ellipse Width="14" Height="14" Fill="#F59E0B"/>
                    </Button>
                    <Button x:Name="BtnColorWhite" Style="{StaticResource ToolbarIconButton}" Width="24" Height="24" Click="BtnColor_Click" Tag="#FFFFFF">
                        <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#71717A" StrokeThickness="0.5"/>
                    </Button>

                    <!-- Full Color Palette Popover Button -->
                    <Grid Margin="2,0,0,0">
                        <Button x:Name="BtnColorPalette" Style="{StaticResource ToolbarIconButton}" Width="26" Height="26" ToolTip="Paleta de Cores Completa" Click="BtnColorPalette_Click" MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <TextBlock Text="🎨" FontSize="13"/>
                        </Button>
                        <Popup x:Name="PopupEditorColorMenu" PlacementTarget="{Binding ElementName=BtnColorPalette}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
                                <StackPanel Orientation="Vertical" Width="220">
                                    <!-- Preview & Hex Input -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#27272A" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse x:Name="EllipseEditorColorPreview" Width="18" Height="18" Fill="#8B5CF6" Stroke="White" StrokeThickness="0.5"/>
                                        </Border>
                                        <TextBox x:Name="TxtEditorColorHex" Grid.Column="1" Height="26" Margin="6,0,4,0" Background="{DynamicResource BgElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,2" FontSize="11" Text="#8B5CF6" VerticalContentAlignment="Center" KeyDown="TxtEditorColorHex_KeyDown"/>
                                        <Button x:Name="BtnApplyEditorColorHex" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="10.5" Content="OK" Click="BtnApplyEditorColorHex_Click" ToolTip="Aplicar código hexadecimal"/>
                                    </Grid>

                                    <!-- Cores Vibrantes -->
                                    <TextBlock Text="Cores Vibrantes" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,3"/>
                                    <WrapPanel Width="216" Margin="0,0,0,6">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#EF4444" ToolTip="Vermelho">
                                            <Ellipse Width="15" Height="15" Fill="#EF4444" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#F97316" ToolTip="Laranja">
                                            <Ellipse Width="15" Height="15" Fill="#F97316" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#F59E0B" ToolTip="Amarelo">
                                            <Ellipse Width="15" Height="15" Fill="#F59E0B" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#10B981" ToolTip="Verde">
                                            <Ellipse Width="15" Height="15" Fill="#10B981" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#06B6D4" ToolTip="Ciano">
                                            <Ellipse Width="15" Height="15" Fill="#06B6D4" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#3B82F6" ToolTip="Azul">
                                            <Ellipse Width="15" Height="15" Fill="#3B82F6" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#8B5CF6" ToolTip="Roxo">
                                            <Ellipse Width="15" Height="15" Fill="#8B5CF6" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#EC4899" ToolTip="Rosa">
                                            <Ellipse Width="15" Height="15" Fill="#EC4899" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Tons Claros e Pastéis -->
                                    <TextBlock Text="Tons Claros &amp; Pastéis" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,3"/>
                                    <WrapPanel Width="216" Margin="0,0,0,6">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#FCA5A5" ToolTip="Vermelho Claro">
                                            <Ellipse Width="15" Height="15" Fill="#FCA5A5" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#FED7AA" ToolTip="Laranja Claro">
                                            <Ellipse Width="15" Height="15" Fill="#FED7AA" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#FEF08A" ToolTip="Amarelo Claro">
                                            <Ellipse Width="15" Height="15" Fill="#FEF08A" Stroke="#71717A" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#A7F3D0" ToolTip="Verde Claro">
                                            <Ellipse Width="15" Height="15" Fill="#A7F3D0" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#A5F3FC" ToolTip="Ciano Claro">
                                            <Ellipse Width="15" Height="15" Fill="#A5F3FC" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#BFDBFE" ToolTip="Azul Claro">
                                            <Ellipse Width="15" Height="15" Fill="#BFDBFE" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#DDD6FE" ToolTip="Lavanda">
                                            <Ellipse Width="15" Height="15" Fill="#DDD6FE" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#FBCFE8" ToolTip="Rosa Claro">
                                            <Ellipse Width="15" Height="15" Fill="#FBCFE8" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Tons Neutros -->
                                    <TextBlock Text="Tons Neutros" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,3"/>
                                    <WrapPanel Width="216">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#000000" ToolTip="Preto">
                                            <Ellipse Width="15" Height="15" Fill="#000000" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#27272A" ToolTip="Grafite">
                                            <Ellipse Width="15" Height="15" Fill="#27272A" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#52525B" ToolTip="Cinza Escuro">
                                            <Ellipse Width="15" Height="15" Fill="#52525B" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#71717A" ToolTip="Cinza Médio">
                                            <Ellipse Width="15" Height="15" Fill="#71717A" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#A1A1AA" ToolTip="Cinza Claro">
                                            <Ellipse Width="15" Height="15" Fill="#A1A1AA" Stroke="White" StrokeThickness="0.5"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="25" Height="25" Margin="1" Click="BtnColor_Click" Tag="#FFFFFF" ToolTip="Branco">
                                            <Ellipse Width="15" Height="15" Fill="#FFFFFF" Stroke="#71717A" StrokeThickness="0.5"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                    <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Desfazer" Click="BtnUndo_Click">
                        <TextBlock Text="↶" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Refazer" Click="BtnRedo_Click">
                        <TextBlock Text="↷" FontSize="14"/>
                    </Button>
                </StackPanel>

                <!-- Right: AI & Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnPin_Click" ToolTip="Fixar na tela (Ctrl+Shift+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" Margin="0,0,4,0"/>
                            <TextBlock Text="Fixar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnOcr_Click" ToolTip="Extrair texto (OCR)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0"/>
                            <TextBlock Text="OCR"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnAskAi_Click" ToolTip="Perguntar à IA">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Margin="0,0,4,0"/>
                            <TextBlock Text="Perguntar à IA"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAiMenu" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="BtnAiMenu_Click" ToolTip="Menu de IA">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="#F59E0B" Margin="0,0,4,0" FontWeight="Bold"/>
                            <TextBlock Text="Menu IA"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="BtnCopy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,4,0"/>
                            <TextBlock Text="Copiar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Canvas / Workspace Viewport -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0C0C11">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Effect="{StaticResource GlassFloatingShadow}">
                    <Grid x:Name="DrawingContainer">
                        <Image x:Name="DisplayImage" Stretch="None" />
                        <Canvas x:Name="EditorAnnotationCanvas"
                                Background="Transparent"
                                MouseDown="Canvas_MouseDown"
                                MouseMove="Canvas_MouseMove"
                                MouseUp="Canvas_MouseUp" />
                        <TextBox x:Name="EditorInlineText"
                                 Visibility="Collapsed"
                                 Background="#18181B"
                                 Foreground="White"
                                 BorderBrush="{StaticResource PurplePrimaryBrush}"
                                 BorderThickness="1.5"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Padding="4"
                                 KeyDown="EditorInlineText_KeyDown"
                                 LostFocus="EditorInlineText_LostFocus" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgSidebarGlassBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusDimensions" DockPanel.Dock="Left" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Dimensões: 0 x 0 px" />
                <TextBlock x:Name="StatusInfo" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" Text="CrankoShot Editor" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
