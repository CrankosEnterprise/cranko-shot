<Window x:Class="ShotMind.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrankoShot — Histórico de Capturas"
        Width="900" Height="620"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowGradientBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Search & Filter Bar -->
            <RowDefinition Height="*" />    <!-- Captures List/Grid -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Search Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0"/>
                        <TextBlock Text="Atualizar"/>
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="10,6" FontSize="13" TextChanged="SearchBox_TextChanged" />
                    <TextBlock IsHitTestVisible="False" Text="Pesquisar por nome de arquivo ou texto..." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Captures List -->
        <Border Grid.Row="1" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <ListBox x:Name="CapturesListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     SelectionChanged="CapturesListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#CC1B1B26" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4,4,4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /> <!-- Thumbnail -->
                                    <ColumnDefinition Width="*" />   <!-- Info -->
                                    <ColumnDefinition Width="Auto" /> <!-- Action buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail Image -->
                                <Border Grid.Column="0" Background="#141416" CornerRadius="4" Width="120" Height="80" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" />
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TimestampFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding DimensionsFormatted}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,12,0"/>
                                        <Border Background="{StaticResource PurpleDarkBrush}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding Format}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Quick Item Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Abrir no Editor" Click="BtnItemEditor_Click" Tag="{Binding}">
                                        <TextBlock Text="📐 Editar"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Copiar Imagem" Click="BtnItemCopy_Click" Tag="{Binding}">
                                        <TextBlock Text="📋 Copiar"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Abrir pasta no Explorer" Click="BtnItemOpenFolder_Click" Tag="{Binding}">
                                        <TextBlock Text="📁 Pasta"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" ToolTip="Excluir do Histórico" Click="BtnItemDelete_Click" Tag="{Binding}">
                                        <TextBlock Text="🗑" Foreground="#EF4444"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearHistory_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" Margin="0,0,4,0"/>
                    <TextBlock Text="Limpar Histórico"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="ItemsCountText" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="0 capturas registradas" />

            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click">
                <TextBlock Text="Fechar"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
