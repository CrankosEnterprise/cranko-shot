<Window x:Class="ShotMind.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrankoShot — Configurações"
        Width="860" Height="660"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowGradientBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" /> <!-- Glass Sidebar Navigation -->
            <ColumnDefinition Width="*" />   <!-- Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Ambient Background Glow Orbs (Purely Decorative Glassmorphism Backdrop) -->
        <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Canvas.Left="-80" Canvas.Top="-90" Opacity="0.14" Fill="{DynamicResource AccentPrimaryBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" Canvas.Right="-60" Canvas.Bottom="-80" Opacity="0.10" Fill="{DynamicResource AccentPrimaryBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- ==================== LEFT GLASS SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel LastChildFill="True">
                <!-- App Identity Header -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource BgGlassCardBrush}"
                        BorderBrush="{StaticResource GlassHighlightBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                CornerRadius="9"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                BorderBrush="#48FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <Grid>
                                <Ellipse Width="16" Height="16" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CrankoShot" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15.5" FontWeight="Bold" />
                            <TextBlock Text="Captura &amp; IA Visual" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer Version Pill -->
                <Border DockPanel.Dock="Bottom"
                        Background="#6614141D"
                        BorderBrush="#1EFFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,12,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="CrankoShot Desktop" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="v2.0" Foreground="{DynamicResource AccentLightBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Sidebar Navigation List -->
                <ListBox x:Name="NavSidebar"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         SelectedIndex="0"
                         SelectionChanged="NavSidebar_SelectionChanged">
                    <ListBoxItem Content="⚙  Geral" />
                    <ListBoxItem Content="⌨  Captura &amp; Atalhos" />
                    <ListBoxItem Content="🎯  Aparência &amp; Mira" />
                    <ListBoxItem Content="🛡  Edição &amp; Censura" />
                    <ListBoxItem Content="💾  Salvamento &amp; Nomes" />
                    <ListBoxItem Content="✦  IA &amp; Provedores" />
                    <ListBoxItem Content="🔍  OCR Local" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== RIGHT CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Category Header -->
                <RowDefinition Height="*" />    <!-- Scrollable Settings Panes -->
                <RowDefinition Height="Auto" /> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Category Title Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgGlassCardBrush}"
                    BorderBrush="{StaticResource GlassHighlightBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtCategoryTitle" Text="Configurações Gerais" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCategorySubtitle" Text="Inicialização, notificações e comportamento do sistema." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="CRANKOSHOT" Foreground="{DynamicResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Scrollable Content Panes -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,10">
                <Grid>

                    <!-- ================= PANE 1: GERAL ================= -->
                    <StackPanel x:Name="PaneGeral" Visibility="Visible">
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sistema e Inicialização" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkRunOnStartup" Content="Iniciar o CrankoShot automaticamente com o Windows" />
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Continuar executando em segundo plano na bandeja do sistema" />
                                <CheckBox x:Name="ChkPlaySound" Content="Reproduzir som suave ao capturar a tela" />
                                <CheckBox x:Name="ChkNotifications" Content="Exibir notificações na bandeja do sistema" />
                            </StackPanel>
                        </Border>

                        <!-- Som da Captura -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Som da Captura" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Escolha o som reproduzido ao capturar, ajuste o volume e importe seus próprios arquivos (WAV ou MP3)." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="Som:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbCaptureSound" Grid.Column="0" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbCaptureSound_SelectionChanged"/>
                                    <Button x:Name="BtnPreviewSound" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="8,0,0,0" Content="▶ Ouvir" ToolTip="Reproduzir o som selecionado com o volume atual" Click="BtnPreviewSound_Click"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,14">
                                    <Button x:Name="BtnImportSound" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,6" Content="Importar som..." ToolTip="Importar um arquivo WAV ou MP3 do computador" Click="BtnImportSound_Click"/>
                                    <Button x:Name="BtnRemoveSound" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0" Margin="0,0,0,6" Content="Remover som importado" ToolTip="Remove o som importado selecionado" Click="BtnRemoveSound_Click"/>
                                </WrapPanel>

                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtSoundVolumeVal" Text="100%" Foreground="{DynamicResource AccentLightBrush}" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"/>
                                    <TextBlock Text="Volume do som da captura:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                </DockPanel>
                                <Slider x:Name="SliderSoundVolume" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8" ValueChanged="SliderSoundVolume_ValueChanged"/>
                                <CheckBox x:Name="ChkMuteSound" Content="Silenciar o som da captura" Checked="ChkMuteSound_Changed" Unchecked="ChkMuteSound_Changed"/>

                                <TextBlock x:Name="TxtSoundStatus" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="O volume é independente do volume geral do Windows: ele ajusta apenas o nível do CrankoShot."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 2: CAPTURA & ATALHOS ================= -->
                    <StackPanel x:Name="PaneCaptura" Visibility="Collapsed">
                        <!-- Atalho Global de Captura -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Atalho Global de Captura" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Defina a tecla ou combinação usada para iniciar a captura de tela em qualquer janela." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Destaque do Atalho Atual + Gravação Direta -->
                                <Border Background="#99101018" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="ATALHO ATUALMENTE CONFIGURADO" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Border x:Name="BorderCurrentHotkeyBadge" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,5" Margin="0,2,10,2">
                                                    <TextBlock x:Name="TxtCurrentHotkeyBadge" Text="Print Screen" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock x:Name="TxtHotkeyStatusText" Text="✓ Ativo no sistema" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnRecordHotkey" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnRecordHotkey_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⌨" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtBtnRecordText" Text="Alterar atalho" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnRestoreDefaultHotkey" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0" Content="Restaurar padrão" Click="BtnRestoreDefaultHotkey_Click" ToolTip="Voltar para Print Screen"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Banner interativo durante modo de gravação de tecla -->
                                <Border x:Name="BorderRecordingIndicator" Visibility="Collapsed" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="🔴" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pressione agora a nova tecla ou combinação (ex.: Ctrl + Shift + S, Alt + Print Screen, F9)... Pressione Esc para cancelar." Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Seleção Manual Alternativa -->
                                <TextBlock Text="Ou selecione manualmente a combinação:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Modificador:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="CmbHotkeyModifier" Height="36" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Nenhum"/>
                                            <ComboBoxItem Content="Ctrl"/>
                                            <ComboBoxItem Content="Alt"/>
                                            <ComboBoxItem Content="Shift"/>
                                            <ComboBoxItem Content="Win"/>
                                            <ComboBoxItem Content="Ctrl + Shift"/>
                                            <ComboBoxItem Content="Ctrl + Alt"/>
                                            <ComboBoxItem Content="Alt + Shift"/>
                                            <ComboBoxItem Content="Win + Shift"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                        <TextBlock Text="Tecla principal:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="CmbHotkeyKey" Height="36" HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="BtnApplyManualHotkey" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" VerticalAlignment="Bottom" Content="Aplicar combinação" Click="BtnApplyManualHotkey_Click"/>
                                </Grid>

                                <!-- Mensagem de Feedback / Validação -->
                                <Border x:Name="BorderHotkeyFeedback" Visibility="Collapsed" CornerRadius="8" Padding="10,8" Margin="0,6,0,0" BorderThickness="1">
                                    <TextBlock x:Name="TxtHotkeyFeedback" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Integração com Print Screen do Windows -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Integração com a Tecla Print Screen do Windows" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ChkOverrideWindowsSnipping" Content="Usar Print Screen no CrankoShot no lugar da Ferramenta de Captura do Windows" />
                                <TextBlock Text="Desativa o vínculo nativo da Ferramenta de Captura nas configurações do usuário atual para liberar a tecla Print Screen." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="29,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Comportamento Pós-Seleção -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Comportamento Pós-Seleção" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Ação padrão ao finalizar captura rápida:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ComboBox x:Name="CmbDefaultAction" Height="36" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Copiar para a Área de Transferência"/>
                                    <ComboBoxItem Content="Salvar em Arquivo Automaticamente"/>
                                    <ComboBoxItem Content="Copiar e Salvar"/>
                                    <ComboBoxItem Content="Manter Barra de Ferramentas Aberta"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Atalhos das Ações do Aplicativo -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Atalhos das Ações (Durante Captura e Editor)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="Personalize os atalhos rápidos usados para copiar, salvar, fixar, desfazer ou acionar a IA." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0" Content="Restaurar todos" Click="BtnRestoreAllShortcuts_Click" VerticalAlignment="Top"/>
                                </Grid>

                                <!-- Banner de gravação de atalho de ação -->
                                <Border x:Name="BorderRecordingActionIndicator" Visibility="Collapsed" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,4,0,10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="🔴" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRecordingActionPrompt" Text="Pressione a nova combinação de teclas... (Esc para cancelar)" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Feedback de conflito / sucesso -->
                                <Border x:Name="BorderActionShortcutFeedback" Visibility="Collapsed" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderThickness="1">
                                    <TextBlock x:Name="TxtActionShortcutFeedback" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Lista de Ações Gerada e Atualizada pelo Código -->
                                <StackPanel x:Name="StackActionShortcutsList" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 3: APARÊNCIA & MIRA ================= -->
                    <StackPanel x:Name="PaneCursor" Visibility="Collapsed">
                        <!-- Tema de Cores da Interface -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Tema de Cores da Interface" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Escolha a cor de destaque aplicada aos painéis translúcidos, botões, bordas e indicadores do CrankoShot." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <UniformGrid Columns="4" Margin="0,0,0,2">
                                    <!-- Roxo (Padrão) -->
                                    <Border x:Name="BorderThemePurple" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,8" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Purple">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#8B5CF6" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Roxo" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusPurple" Text="Padrão" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Vermelho -->
                                    <Border x:Name="BorderThemeRed" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,8" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Red">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#EF4444" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Vermelho" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusRed" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Rosa -->
                                    <Border x:Name="BorderThemePink" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,8" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Pink">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#EC4899" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Rosa" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusPink" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Verde -->
                                    <Border x:Name="BorderThemeGreen" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,8" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Green">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#10B981" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Verde" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusGreen" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Amarelo -->
                                    <Border x:Name="BorderThemeYellow" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,0" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Yellow">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#F59E0B" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Amarelo" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusYellow" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Cinza -->
                                    <Border x:Name="BorderThemeGray" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,0" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Gray">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#71717A" Stroke="#E4E4E7" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Cinza" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusGray" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Laranja -->
                                    <Border x:Name="BorderThemeOrange" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,8,0" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Orange">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#F97316" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Laranja" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusOrange" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <!-- Azul -->
                                    <Border x:Name="BorderThemeBlue" Background="#B814141E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,0" Padding="10,8">
                                        <Button Style="{StaticResource ToolbarIconButton}" Width="Auto" Height="Auto" HorizontalContentAlignment="Stretch" Click="BtnSelectTheme_Click" Tag="Blue">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse Width="18" Height="18" Fill="#3B82F6" Stroke="White" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Azul" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeStatusBlue" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Prévia Interativa da Mira em Tempo Real -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Prévia da Mira em Tempo Real" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtCrosshairStyleSubtitle" Text="Visualize como a mira se comporta sobre superfícies escuras e claras antes de salvar." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCrosshairActiveBadge" Text="Mira simples" Foreground="{DynamicResource AccentLightBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Split Preview Canvas (Dark Surface vs Light/White Surface) -->
                                <Border BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Height="118" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Dark Surface Zone -->
                                        <Border Grid.Column="0" Background="#101017" BorderBrush="#26FFFFFF" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8">
                                                    <TextBlock Text="FUNDO ESCURO" Foreground="#71717A" FontSize="9.5" FontWeight="Bold"/>
                                                    <TextBlock Text="Janela / Tema Dark" Foreground="#52525B" FontSize="10"/>
                                                </StackPanel>
                                                <Image x:Name="ImgPreviewCrosshairDark"
                                                       Width="80" Height="80"
                                                       Stretch="None"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Light / White Surface Zone -->
                                        <Border Grid.Column="1" Background="#F8FAFC">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8">
                                                    <TextBlock Text="FUNDO CLARO / BRANCO" Foreground="#64748B" FontSize="9.5" FontWeight="Bold"/>
                                                    <TextBlock Text="Documento / Página Web" Foreground="#94A3B8" FontSize="10"/>
                                                </StackPanel>
                                                <Image x:Name="ImgPreviewCrosshairLight"
                                                       Width="80" Height="80"
                                                       Stretch="None"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Formato da Mira -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Formato da Mira" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Selecione o formato estrutural da mira exibida durante a seleção da área de captura." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <UniformGrid Columns="5" Margin="0,0,0,10">
                                    <Button x:Name="BtnCrosshairSimple" Style="{StaticResource ChipButtonStyle}" Height="58" Padding="4,4" Margin="0,0,6,0" Click="BtnCrosshairStyle_Click" Tag="Simple" ToolTip="Mira simples com aparência semelhante à padrão">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="✛" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Simples" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCrosshairOpen" Style="{StaticResource ChipButtonStyle}" Height="58" Padding="4,4" Margin="0,0,6,0" Click="BtnCrosshairStyle_Click" Tag="Open" ToolTip="Mira aberta: linhas separadas, sem ponto central">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⛶" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Aberta" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCrosshairClosed" Style="{StaticResource ChipButtonStyle}" Height="58" Padding="4,4" Margin="0,0,6,0" Click="BtnCrosshairStyle_Click" Tag="Closed" ToolTip="Mira fechada: linhas formando uma cruz contínua">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="✚" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Fechada" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCrosshairCenterDot" Style="{StaticResource ChipButtonStyle}" Height="58" Padding="4,4" Margin="0,0,6,0" Click="BtnCrosshairStyle_Click" Tag="CenterDot" ToolTip="Mira com ponto central">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⊙" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Ponto Central" FontSize="10.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCrosshairLinesAndDot" Style="{StaticResource ChipButtonStyle}" Height="58" Padding="4,4" Margin="0" Click="BtnCrosshairStyle_Click" Tag="LinesAndDot" ToolTip="Mira com linhas separadas e ponto central">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⌖" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                            <TextBlock Text="Linhas + Ponto" FontSize="10.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Dropdown sincronizado também disponível para acessibilidade -->
                                <ComboBox x:Name="CmbCrosshairStyle" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbCrosshairStyle_SelectionChanged">
                                    <ComboBoxItem Content="Mira simples (semelhante à padrão atual)" />
                                    <ComboBoxItem Content="Mira aberta (linhas separadas, sem ponto central)" />
                                    <ComboBoxItem Content="Mira fechada (linhas formando uma cruz contínua)" />
                                    <ComboBoxItem Content="Mira com ponto central" />
                                    <ComboBoxItem Content="Mira com linhas e ponto central" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Inversão de Cores Localizada & Cor da Mira -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Inversão de Cores Localizada &amp; Contraste" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkAutoContrastCursor"
                                          Content="Inversão de cores localizada na mira (inverter apenas os pixels cobertos pelos traços)"
                                          Checked="ChkAutoContrastCursor_CheckedChanged"
                                          Unchecked="ChkAutoContrastCursor_CheckedChanged" />
                                <TextBlock Text="Ao passar sobre uma superfície branca, os traços da mira ficam escuros; sobre fundo escuro, ficam claros em tempo real, sem alterar o restante da tela."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="29,2,0,12"/>

                                <CheckBox x:Name="ChkCrosshairOutline"
                                          Content="Adicionar contorno de contraste para reforçar a visibilidade (no modo de cor fixa)"
                                          Checked="CrosshairOption_Changed"
                                          Unchecked="CrosshairOption_Changed" />

                                <CheckBox x:Name="ChkCrosshairShowDot"
                                          Content="Ativar ponto central na mira"
                                          Checked="CrosshairOption_Changed"
                                          Unchecked="CrosshairOption_Changed"
                                          Margin="0,6,0,12" />

                                <!-- Seleção de Cor Fixa (quando a inversão localizada está desativada) -->
                                <Border x:Name="PanelManualCursorColor"
                                        Background="#9912121A"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Cor Personalizada da Mira (quando a inversão localizada estiver desativada):"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   Margin="0,0,0,10"/>

                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#8B5CF6" ToolTip="Roxo CrankoShot">
                                                <Ellipse Width="16" Height="16" Fill="#8B5CF6" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#FFFFFF" ToolTip="Branco">
                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#3F3F46" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#111111" ToolTip="Preto">
                                                <Ellipse Width="16" Height="16" Fill="#111111" Stroke="#A1A1AA" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#00E5FF" ToolTip="Ciano Neon">
                                                <Ellipse Width="16" Height="16" Fill="#00E5FF" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#10B981" ToolTip="Verde">
                                                <Ellipse Width="16" Height="16" Fill="#10B981" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#F59E0B" ToolTip="Amarelo">
                                                <Ellipse Width="16" Height="16" Fill="#F59E0B" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#EF4444" ToolTip="Vermelho">
                                                <Ellipse Width="16" Height="16" Fill="#EF4444" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="BtnCursorSwatch_Click" Tag="#EC4899" ToolTip="Rosa">
                                                <Ellipse Width="16" Height="16" Fill="#EC4899" Stroke="White" StrokeThickness="1"/>
                                            </Button>
                                        </WrapPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Rectangle x:Name="RectCursorColorPreview" RadiusX="6" RadiusY="6" Fill="#8B5CF6" Margin="3"/>
                                            </Border>
                                            <TextBox Grid.Column="1" x:Name="TxtCursorColorHex" Text="#8B5CF6" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="TxtCursorColorHex_TextChanged"/>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Content="Escolher Outra Cor..." Click="BtnChooseCustomCursorColor_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Ajustes Finos de Espessura, Comprimento e Ponto Central -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Geometria e Dimensões da Mira" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Espessura das Linhas -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtCrosshairThicknessVal" Text="2 px" Foreground="{DynamicResource AccentLightBrush}" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"/>
                                            <TextBlock Text="Espessura das linhas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderCrosshairThickness" Minimum="1" Maximum="6" Value="2" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderCrosshairGeometry_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Comprimento das Linhas -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtCrosshairLengthVal" Text="12 px" Foreground="{DynamicResource AccentLightBrush}" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"/>
                                            <TextBlock Text="Comprimento das linhas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderCrosshairLength" Minimum="4" Maximum="28" Value="12" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderCrosshairGeometry_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Espaçamento Central -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtCrosshairGapVal" Text="4 px" Foreground="{DynamicResource AccentLightBrush}" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"/>
                                            <TextBlock Text="Abertura central (vão):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderCrosshairGap" Minimum="1" Maximum="14" Value="4" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderCrosshairGeometry_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Tamanho do Ponto Central -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtCrosshairDotSizeVal" Text="3 px" Foreground="{DynamicResource AccentLightBrush}" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"/>
                                            <TextBlock Text="Tamanho do ponto central:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderCrosshairDotSize" Minimum="1" Maximum="10" Value="3" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderCrosshairGeometry_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <!-- Escala rápida: multiplicador proporcional de TODAS as dimensões (espessura, comprimento, abertura e ponto) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Escala rápida da mira:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbCursorSize" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbCursorSize_SelectionChanged">
                                        <ComboBoxItem Content="Compacto (0,75×)"/>
                                        <ComboBoxItem Content="Normal — Padrão (1×)"/>
                                        <ComboBoxItem Content="Grande (1,5×)"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="A escala multiplica proporcionalmente espessura, comprimento, abertura central e ponto central, sobre os valores definidos acima." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 4: EDIÇÃO & CENSURA ================= -->
                    <StackPanel x:Name="PaneEdicao" Visibility="Collapsed">
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Ferramenta de Ocultação / Censura" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Defina o comportamento padrão de desfoque e mosaico utilizado para ocultar dados sensíveis durante a captura ou no editor." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Estilo padrão:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="CmbObfuscationStyle" Height="36" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Pixelado (Mosaico)"/>
                                            <ComboBoxItem Content="Desfoque Suave (Blur)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Intensidade padrão (4 a 64):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBox x:Name="TxtObfuscationIntensity" Text="12" Height="36" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 5: SALVAMENTO & NOMES ================= -->
                    <StackPanel x:Name="PaneSalvamento" Visibility="Collapsed">
                        <!-- Pasta e Formato -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Destino e Formato" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Configure o diretório padrão onde as capturas são salvas e o formato de compressão de imagem." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Pasta padrão para salvar capturas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSaveDirectory" Grid.Column="0" Height="36" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Procurar..." Height="36" Padding="14,0" Margin="8,0,0,0" Click="BtnBrowseDirectory_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Formato da imagem:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="CmbImageFormat" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbImageFormat_SelectionChanged">
                                            <ComboBoxItem Content="PNG"/>
                                            <ComboBoxItem Content="JPG"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Qualidade JPG (%):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBox x:Name="TxtJpgQuality" Text="92" Height="36" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Padrão do Nome do Arquivo -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Estrutura do Nome do Arquivo" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <TextBox x:Name="TxtFilenamePattern"
                                         Text="CrankoShot_{yyyy-MM-dd_HH-mm-ss}"
                                         Height="38"
                                         FontSize="13.5"
                                         FontWeight="Medium"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtFilenamePattern_TextChanged"
                                         Margin="0,0,0,10"/>

                                <!-- Pré-visualização em tempo real -->
                                <Border Background="#99101018" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Pré-visualização:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtFilenamePreview" Text="CrankoShot_2026-10-14_09-30-00.png" Foreground="{DynamicResource AccentLightBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtFilenameValidation" Text="✓ Padrão válido para nomes de arquivo do Windows" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Modelos -->
                                <TextBlock Text="Modelos rápidos:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="30" Height="Auto" Content="CrankoShot_{yyyy-MM-dd_HH-mm-ss}" Margin="0,0,6,6" Tag="CrankoShot_{yyyy-MM-dd_HH-mm-ss}" Click="BtnPresetFilename_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="30" Height="Auto" Content="Captura_{yyyy-MM-dd}_{HH-mm-ss}" Margin="0,0,6,6" Tag="Captura_{yyyy-MM-dd}_{HH-mm-ss}" Click="BtnPresetFilename_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="30" Height="Auto" Content="Print_{dd-MM-yyyy}_{HH-mm}" Margin="0,0,6,6" Tag="Print_{dd-MM-yyyy}_{HH-mm}" Click="BtnPresetFilename_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="30" Height="Auto" Content="CrankoShot_{seq}" Margin="0,0,6,6" Tag="CrankoShot_{seq}" Click="BtnPresetFilename_Click"/>
                                </WrapPanel>

                                <!-- Variáveis -->
                                <TextBlock Text="Variáveis:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Data" Margin="0,0,5,5" Tag="{}{data}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Hora" Margin="0,0,5,5" Tag="{}{hora}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Ano" Margin="0,0,5,5" Tag="{}{yyyy}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Mês" Margin="0,0,5,5" Tag="{}{MM}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Dia" Margin="0,0,5,5" Tag="{}{dd}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="+ Sequencial" Margin="0,0,5,5" Tag="{}{seq}" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="_" Margin="0,0,5,5" Tag="_" Click="BtnInsertToken_Click"/>
                                    <Button Style="{StaticResource ChipButtonStyle}" MinHeight="28" Height="Auto" Content="-" Margin="0,0,5,5" Tag="-" Click="BtnInsertToken_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Numeração Sequencial -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Numeração Sequencial" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Próximo número:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBox x:Name="TxtSequenceCounter" Text="1" Height="36" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" TextChanged="TxtSequence_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Quantidade de dígitos:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="CmbSequenceDigits" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbSequenceDigits_SelectionChanged">
                                            <ComboBoxItem Content="1 dígito (ex.: 1)"/>
                                            <ComboBoxItem Content="2 dígitos (ex.: 01)"/>
                                            <ComboBoxItem Content="3 dígitos (ex.: 001)"/>
                                            <ComboBoxItem Content="4 dígitos (ex.: 0001)"/>
                                            <ComboBoxItem Content="5 dígitos (ex.: 00001)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 6: INTELIGÊNCIA ARTIFICIAL (GEMINI & OPENROUTER) ================= -->
                    <StackPanel x:Name="PaneIA" Visibility="Collapsed">
                        <!-- Seleção de Provedor Ativo -->
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Provedor Principal de Inteligência Artificial" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="Escolha qual provedor será utilizado para análise de imagens, extração de texto, tradução, resumos, diagnósticos e conversa com a IA. Suas chaves e modelos ficam salvos individualmente em cada provedor."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtActiveAiProviderBadge" Text="Google Gemini" Foreground="{DynamicResource AccentLightBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnProviderGemini" Grid.Column="0" Style="{StaticResource ChipButtonStyle}" Height="56" Margin="0,0,6,0" Padding="12,6" Click="BtnSelectAiProvider_Click" Tag="Active">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="✦ Google Gemini" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="API Oficial Google AI Studio + Pesquisa Web" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnProviderOpenRouter" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Height="56" Margin="6,0,0,0" Padding="12,6" Click="BtnSelectAiProvider_Click" Tag="OpenRouter">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡ OpenRouter" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Modelos Gratuitos (:free) de Visão e Texto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Provedor 1: Google Gemini -->
                        <Border x:Name="CardGeminiSettings" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Google Gemini — Chave de API e Modelo" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="Armazenamento seguro com criptografia DPAPI do Windows. Também utilizado pela função 'Pesquisar na Web com Gemini'." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="BadgeGeminiActiveState" Grid.Column="1" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtGeminiActiveState" Text="✓ Provedor Ativo" Foreground="{StaticResource SuccessBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TxtGeminiApiKey" Grid.Column="0" Height="36" FontSize="13" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="BtnTestApi" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="8,0,0,0" Content="Testar Conexão" Click="BtnTestApi_Click"/>
                                </Grid>

                                <TextBlock x:Name="TxtApiKeyStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="Nenhuma chave configurada." Margin="0,0,0,12" />

                                <TextBlock Text="Modelo do Google Gemini:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ComboBox x:Name="CmbGeminiModel" Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,6" SelectionChanged="CmbGeminiModel_SelectionChanged"/>
                                <TextBlock x:Name="TxtModelDescription" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Provedor 2: OpenRouter -->
                        <Border x:Name="CardOpenRouterSettings" Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="OpenRouter — Chave de API e Modelos" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="Provedor independente via API oficial (openrouter.ai/api/v1). Chave protegida localmente com DPAPI." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="BadgeOpenRouterActiveState" Grid.Column="1" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Top" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtOpenRouterActiveState" Text="✓ Provedor Ativo" Foreground="{StaticResource SuccessBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TxtOpenRouterApiKey" Grid.Column="0" Height="36" FontSize="13" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="BtnTestOpenRouterApi" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="8,0,0,0" Content="Testar Conexão" Click="BtnTestOpenRouterApi_Click"/>
                                </Grid>

                                <TextBlock x:Name="TxtOpenRouterApiKeyStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="Nenhuma chave do OpenRouter configurada." Margin="0,0,0,12" />

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkOpenRouterFreeOnly"
                                              Grid.Column="0"
                                              Content="Exibir apenas modelos gratuitos (:free) verificados"
                                              IsChecked="True"
                                              Margin="0,0,10,0"
                                              Checked="ChkOpenRouterFreeOnly_Changed"
                                              Unchecked="ChkOpenRouterFreeOnly_Changed"/>
                                    <Button x:Name="BtnRefreshOpenRouterModels"
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0"
                                            Content="🔄 Atualizar Modelos"
                                            Click="BtnRefreshOpenRouterModels_Click"
                                            ToolTip="Consultar catálogo atualizado na API oficial do OpenRouter"/>
                                </Grid>

                                <TextBlock Text="Modelo do OpenRouter (priorizando Visão + Texto gratuitos):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                <ComboBox x:Name="CmbOpenRouterModel" Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,8" SelectionChanged="CmbOpenRouterModel_SelectionChanged"/>

                                <WrapPanel Margin="0,0,0,6">
                                    <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,4">
                                        <TextBlock x:Name="TxtOpenRouterModalityBadge" Text="Modalidade: Visão + Texto" Foreground="{DynamicResource AccentLightBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,4">
                                        <TextBlock x:Name="TxtOpenRouterPricingBadge" Text="Custo: Gratuito ($0)" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock x:Name="TxtOpenRouterModelDescription" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= PANE 7: OCR LOCAL ================= -->
                    <StackPanel x:Name="PaneOCR" Visibility="Collapsed">
                        <Border Background="{StaticResource BgGlassCardBrush}" BorderBrush="{StaticResource GlassHighlightBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Reconhecimento de Texto (OCR)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock Text="Processamento local e offline através do Windows.Media.Ocr." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock x:Name="TxtOcrStatus" Foreground="{StaticResource SuccessBrush}" FontSize="12.5" FontWeight="SemiBold" Text="Motor de OCR detectado e pronto para uso." Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtOcrLanguages" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Idiomas suportados: pt-BR, en-US" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Dialog Footer Buttons -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnSaveSettings" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Salvar Configurações" Width="174" Height="36" Click="BtnSaveSettings_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Cancelar" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
